# skilly deployment configuration (SKILLY_SPEC.md §13).
# Copy to .env and fill in. NEVER commit .env. Secrets are injected at runtime only.
# ⚠ Replace EVERY placeholder below (change-me… / generate-with… / all-zero GUID) before deploying — none are safe defaults.

# --- Public URL (used by OIDC redirect + install-URL generation) ---
PUBLIC_BASE_URL=https://skilly.example.com

# --- Postgres ---
POSTGRES_USER=skilly
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=skilly
# Least-privilege app role password (web/worker connect as skilly_app)
SKILLY_APP_PASSWORD=change-me-strong-app
# Web connection-pool size per replica (default 25). A skill page fans out ~20 parallel reads,
# so keep it well above 10; replicas x this + the worker's 10 must stay under Postgres's
# max_connections (default 100).
# WEB_PG_POOL_MAX=25

# --- Next.js / Auth.js ---
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Microsoft Entra ID (OIDC SSO) ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-entra-app-client-secret

# --- Bootstrap first Platform Admin (Entra group object id) ---
# Members of this group are Platform Admins from first boot (chicken-and-egg fix).
SKILLY_BOOTSTRAP_ADMIN_GROUP=00000000-0000-0000-0000-000000000000

# --- SCIM provisioning (Entra Enterprise App -> worker /scim/v2) ---
# Bearer token Entra presents on every SCIM request. Treat as a secret.
SCIM_BEARER_TOKEN=generate-a-long-random-token

# --- Object storage (MinIO bundled; or point at real S3) ---
# Root credentials of the bundled MinIO. Used ONLY by the minio container and the one-shot
# minio-init job — web and worker never receive them (SKILLY_SPEC.md §49.12).
MINIO_ROOT_USER=skilly
MINIO_ROOT_PASSWORD=change-me-strong-minio
# Bucket-scoped service account web + worker authenticate with (REQUIRED, §49.12). minio-init
# creates/updates this IAM user in the bundled MinIO with a policy limited to S3_BUCKET; re-running
# `docker compose up` with a new S3_SECRET_KEY rotates it. Pick values DIFFERENT from MINIO_ROOT_*
# (an access key >= 3 chars, a secret >= 8 chars). For an external S3, set the account's keys here.
S3_ACCESS_KEY=skilly-app
S3_SECRET_KEY=change-me-strong-s3-account
# S3_BUCKET=skilly-artifacts   # must match on web + worker (compose passes the same value to both)
# The MinIO console (:9001) is bound to 127.0.0.1 on the host only — tunnel to it if needed.

# --- Tokens ---
ONE_TIME_TOKEN_TTL_SECONDS=300   # one-time install token TTL (configurable, §9)

# --- Content-Security-Policy (web, §22) ---
# enforce (default) | report-only | off:
#   enforce      strict nonce-based CSP (the shipped default even when unset; recommended).
#   report-only  send Content-Security-Policy-Report-Only — NOTHING is blocked, violations POST to
#                /api/csp-report — use to shake out a custom edge/proxy or overrides before enforcing.
#   off          revert to the legacy 'unsafe-inline' script policy (escape hatch).
# Production-only: `next dev` always uses the lenient dev policy regardless of this value.
# CSP_MODE=enforce

# --- Client IP behind the proxies (worker AND web, §9/§22/§23/§49.9) ---
# So the worker sees the real client IP — recorded for an install (shown on /installed) AND used
# as the key of every per-IP rate limit — instead of the reverse proxy's address. Passed to Express
# `trust proxy`: a hop count ("1"), "true"/"false", a preset ("loopback"), or a comma-separated
# subnet list. UNSET = don't trust X-Forwarded-For: installs record the socket peer and EVERY client
# shares the proxy's single rate-limit bucket. Set to the number of proxies in front of the worker
# (e.g. 2 for an org edge proxy -> the bundled Caddy -> worker).
# Compose passes the same value to WEB, where it keys the OAuth dynamic-client-registration
# (/oauth/register) per-IP rate limit (§49.9) — unset, every DCR caller shares one bucket.
# TRUST_PROXY=1

# --- Worker rate limits (§22) ---
# One limiter per surface, per worker instance. Positive integers; unset/invalid = the default
# (an invalid value also logs a startup warning). /healthz /readyz /metrics are never limited.
# Git per-IP flood guard (git smart-HTTP paths only, before auth):
# GIT_IP_RATE_MAX=600
# GIT_IP_RATE_WINDOW_MS=60000
# Git per-installation bucket (after auth; one `npx skills add` costs ~3-5 requests):
# GIT_TOKEN_RATE_MAX=300
# GIT_TOKEN_RATE_WINDOW_MS=900000
# SCIM provisioning (/scim/v2), per IP — sized for an Entra initial-sync burst:
# SCIM_RATE_MAX=600
# SCIM_RATE_WINDOW_MS=60000

# --- Observability (§14) ---
# If set, GET /metrics on web + worker requires "Authorization: Bearer <token>".
# Leave unset to expose metrics unauthenticated on the internal network.
# METRICS_TOKEN=
# Pointer re-scan / drift-check cadence (worker, leader-only). Default 24h.
# POINTER_REFRESH_INTERVAL_MS=86400000

# --- Notification delivery (all optional; the in-app inbox always works, §12) ---
# Graph email service account (preferred email transport): a platform admin connects a
# Microsoft 365 service mailbox from the Administration page. Requires a SEPARATE Entra
# app registration (not the OIDC app) with delegated Mail.Send + offline_access
# (admin-consented), Assignment required = Yes (assign only the service mailbox user),
# and redirect URI <PUBLIC_BASE_URL>/api/admin/email/callback.
# EMAIL_TOKEN_ENC_KEY=    # openssl rand -base64 32  (must decode to exactly 32 bytes)
# ENTRA_EMAIL_CLIENT_ID=  # client id of the email-only app registration
# ENTRA_EMAIL_CLIENT_SECRET=  # its client secret
# --- AI integration (optional, §40) ---
# Encrypts the AI provider token a platform admin saves on the Administration page (Open WebUI
# or the Anthropic API). Shared by web + worker. Unset = the AI integration card is disabled.
# AI_TOKEN_ENC_KEY=       # openssl rand -base64 32  (must decode to exactly 32 bytes)
# The AI provider base URL an admin saves is refused when it resolves to a private / loopback /
# link-local address (SSRF guard, §49.11). Set to 1 ONLY when the provider (e.g. a self-hosted
# Open WebUI) genuinely lives on your own network; leave unset for any public provider.
# AI_ALLOW_PRIVATE_BASE_URL=
# Encrypts the recoverable copy of each install token so its owner can re-show the install command
# from Installed skills ("Show install URL", §23). Shared by web + worker. Unset = installs mint as before with no
# stored copy and the button never appears. Replacing the key makes earlier copies unrecoverable.
# INSTALL_TOKEN_ENC_KEY=  # openssl rand -base64 32  (must decode to exactly 32 bytes)
# SMTP: the fallback email transport (plain-text) when no Graph account is operational.
# Leave SMTP_HOST unset to disable.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0            # 1 for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=skilly@example.com
# Outbound webhook: POST a JSON body per notification (Teams/Slack incoming webhook URL).
# NOTIFY_WEBHOOK_URL=
